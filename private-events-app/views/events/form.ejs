<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= event ? 'Edit' : 'New' %> event - Private Events</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
<%- include('../partials/header') %>
<main class="main-content">
  <div class="card">
    <h1><%= event ? 'Edit event' : 'Create event' %></h1>
    <form method="post" action="<%= event ? '/events/' + event.id + '/edit' : '/events/new' %>">
      <div class="form-group">
        <label>Title</label>
        <input type="text" name="title" value="<%= event ? event.title : '' %>" required>
      </div>
      <div class="form-group">
        <label>Description</label>
        <input type="text" name="description" value="<%= event ? event.description : '' %>">
      </div>
      <div class="form-group">
        <label>Date</label>
        <input type="date" name="event_date" value="<%= event ? event.event_date : '' %>" required>
      </div>
      <div class="form-group">
        <label>Time</label>
        <input type="time" name="event_time" value="<%= event ? event.event_time : '19:00' %>">
      </div>
      <div class="form-group">
        <label>Location</label>
        <input type="text" name="location" value="<%= event ? event.location : '' %>">
      </div>
      <button type="submit"><%= event ? 'Save' : 'Create' %></button>
    </form>
  </div>
</main>
</body>
</html>